# Hay dos proyectos Supabase: staging (uchejlyyabtrjoxyydmb) y prod (mgtaeogxzuavxrfhrefi).
# El desarrollo local va SIEMPRE contra staging; los valores de prod solo viven en el
# entorno Production de Cloudflare Pages (branch main) y en Bitwarden.
# Valores de staging: Bitwarden, o el perfil `staging` de mobile/eas.json.
# Las VITE_* se hornean en build: cambiarlas exige rebuild/redeploy.
VITE_SUPABASE_URL=https://uchejlyyabtrjoxyydmb.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key-de-staging>
